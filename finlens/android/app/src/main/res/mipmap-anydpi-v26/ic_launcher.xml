<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <!--
    No inset. ic_launcher_foreground.png already carries its own safe-zone
    margin — its glyph is 41.2% of the PNG canvas — so an inset here applied the
    margin a second time and shrank the glyph from 44.5dp to 30.3dp, i.e. to 42%
    of the 72dp the launcher actually shows. The legacy mipmap icon renders the
    same artwork at 62.5% and the iOS icon at 62.0%; without the inset this path
    lands at 61.8% and the three agree (task 039).

    If this file is ever regenerated by a launcher-icon tool, check this line
    first: the inset is what such tools add by default.
  -->
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
