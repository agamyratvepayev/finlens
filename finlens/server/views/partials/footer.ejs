<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <span class="brand__name">FinLens</span>
      <p class="site-footer__tagline"><%= t.footer.tagline %></p>
    </div>

    <div class="site-footer__links">
      <a href="/<%= lang %>/privacy"><%= t.footer.privacy %></a>
    </div>

    <div class="site-footer__lang">
      <span class="site-footer__lang-label"><%= t.footer.language %></span>
      <%- include('lang-switcher') %>
    </div>
  </div>
  <div class="container site-footer__legal">
    <span>© 2026 FinLens. <%= t.footer.rights %></span>
  </div>
</footer>
