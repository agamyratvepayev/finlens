# ── FinLens landing server ──
# Copy to .env and fill in. .env is git-ignored.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Public base URL (used for canonical / OG tags). No trailing slash.
BASE_URL=http://localhost:3000

# Postgres. Either give a full DATABASE_URL, or leave it empty and set PG* parts.
DATABASE_URL=postgres://finlens:finlens@localhost:5432/finlens_landing
# PGHOST=localhost
# PGPORT=5432
# PGUSER=finlens
# PGPASSWORD=finlens
# PGDATABASE=finlens_landing

# Redis
REDIS_URL=redis://localhost:6379

# Secret used to sign cookies (change to a long random string in production).
COOKIE_SECRET=change-me-to-a-long-random-string

# Contact-form rate limit: max POSTs per IP inside the time window (ms).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=3600000
